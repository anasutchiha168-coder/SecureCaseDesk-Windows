{
  "expo": {
    "name": "SecureCaseDesk",
    "slug": "securecasedesk",
    "version": "2.2.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "securecasedesk",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "gov.moi.hajjah.securecasedesk"
    },
    "android": {
      "package": "gov.moi.hajjah.securecasedesk",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#000000"
      },
      "allowBackup": false
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": "يُستخدم للتحقق من هويتك بأمان."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "يُستخدم للتحقق من هويتك بأمان."
        }
      ],
      "expo-sharing"
    ],
    "extra": {
      "router": {
        "origin": false,
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "ea317897-25e9-442a-ab3f-fae7771ebdae"
      }
    },
    "experiments": {
      "typedRoutes": true
    },
    "icon": "./assets/icon.png",
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
